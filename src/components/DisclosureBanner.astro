---
export interface Props {
  compact?: boolean;
  className?: string;
}

const { compact = false, className = '' } = Astro.props;
---

<aside
  aria-label="Editorial testing standards"
  class:list={[
    'border-y border-border-subtle bg-transparent text-xs text-muted flex flex-wrap items-center justify-between gap-x-6 gap-y-2',
    compact ? 'py-2' : 'py-2.5',
    className,
  ]}
>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 min-w-0">
    <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.09em] text-matcha shrink-0">
      Independent Studio Lab
    </span>
    <p class="leading-relaxed">
      100% independent tea vessel archive—zero paid placements or sponsored rankings. Every teapot
      is bench-tested for laminar spout cut-off and 30-minute heat retention.
    </p>
  </div>
  <a
    href="/about/"
    class="inline-flex items-center min-h-[44px] font-mono text-[11px] font-semibold uppercase tracking-wider text-matcha underline underline-offset-4 hover:text-terracotta-text shrink-0"
  >
    Testing Methodology &rarr;
  </a>
</aside>
