---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DisclosureBanner from '../components/DisclosureBanner.astro';
import {
  SITE_URL,
  EDITORIAL_AUTHOR,
  getClusterMeta,
  getClusterHubHref,
  getTeapotLeafSlug,
  getGuideUrl,
  estimateReadingTime,
  formatScore,
} from '../lib/clusterUi';
import { getTeapotMarketData } from '../data/teapotMarketData';

export interface Props {
  entry: CollectionEntry<'teapots'>;
}

const { entry } = Astro.props;
const {
  name,
  subtitle,
  description,
  badge,
  material,
  style,
  capacityLabel,
  capacityTier,
  priceTier,
  pourScore,
  heatScore,
  infuserType,
  stovetopSafe,
  image,
  imageAlt,
  bestFor,
  pros,
  cons,
  verdict,
  relatedCluster,
} = entry.data;

const slug = getTeapotLeafSlug(entry);
const pagePath = `/gallery/${slug}/`;
const pageUrl = new URL(pagePath, SITE_URL).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, SITE_URL).toString();
const combinedRating = Number(((pourScore + heatScore) / 2).toFixed(1));
const clampedPour = Math.max(1, Math.min(10, pourScore));
const clampedHeat = Math.max(1, Math.min(10, heatScore));
const pourLabel = formatScore(clampedPour);
const heatLabel = formatScore(clampedHeat);
const clusterMeta = getClusterMeta(relatedCluster);
const clusterHubHref = getClusterHubHref(relatedCluster);

let featuredInGuides: CollectionEntry<'guides'>[] = [];
let relatedGuides: CollectionEntry<'guides'>[] = [];
try {
  const allGuides = await getCollection('guides');
  const sortGuides = (a: CollectionEntry<'guides'>, b: CollectionEntry<'guides'>) => {
    if (a.data.isPillar !== b.data.isPillar) return a.data.isPillar ? -1 : 1;
    return b.data.updatedDate.getTime() - a.data.updatedDate.getTime();
  };

  featuredInGuides = allGuides
    .filter((g) => g.data.affiliateProducts?.some((p) => p.teapotSlug === slug))
    .sort(sortGuides);

  const featuredSlugs = new Set(featuredInGuides.map((g) => g.slug));

  relatedGuides = allGuides
    .filter((g) => g.data.cluster === relatedCluster && !featuredSlugs.has(g.slug))
    .sort(sortGuides)
    .slice(0, 3);
} catch {
  featuredInGuides = [];
  relatedGuides = [];
}

const TEAPOT_SEO_META: Record<
  string,
  { title: string; description?: string; brand: string }
> = {
  'bredemeijer-duet-bella-ronde-insulated': {
    title: 'Bredemeijer Duet Bella Ronde Review | TeapotsCool',
    brand: 'Bredemeijer',
  },
  'hario-chacha-kyusu-maru-700': {
    title: 'Hario ChaCha Kyusu Maru 700ml Review | TeapotsCool',
    description:
      'Hands-on test of the Hario ChaCha Kyusu Maru 700ml glass teapot, examining laminar spout cut-off, deep stainless mesh basket space, and thermal behavior.',
    brand: 'Hario',
  },
  'iwachu-arare-cast-iron-tetsubin': {
    title: 'Iwachu Arare Cast Iron Tetsubin Review | TeapotsCool',
    brand: 'Iwachu',
  },
  'kamjove-magnetic-automatic-glass-gongfu': {
    title: 'Kamjove Magnetic Gongfu Teapot Review | TeapotsCool',
    brand: 'Kamjove',
  },
  'old-dutch-sagaform-cast-iron-hobnail': {
    title: 'Old Dutch Cast Iron Hobnail Pot Review | TeapotsCool',
    brand: 'Old Dutch International',
  },
  'sweese-porcelain-fluted-infuser-teapot': {
    title: 'Sweese Fluted Porcelain Teapot Review | TeapotsCool',
    description:
      'Studio lab review of the Sweese 800ml fluted glazed porcelain teapot, testing laminar spout flow, stain resistance, and afternoon tea heat retention.',
    brand: 'Sweese',
  },
  'teabloom-celebration-stovetop-glass': {
    title: 'Teabloom Celebration Glass Pot Review | TeapotsCool',
    description:
      'Lab test of the Teabloom Celebration 1200ml stovetop borosilicate glass teapot covering spout flow control, blooming tea space, and thermal safety.',
    brand: 'Teabloom',
  },
  'tokoname-gyokko-yokode-kyusu': {
    title: 'Tokoname Gyokko Yokode Kyusu Review | TeapotsCool',
    brand: 'Gyokko Kiln',
  },
  'yixing-zhuni-shui-ping-clay-teapot': {
    title: 'Yixing Zhuni Shui Ping Teapot Review | TeapotsCool',
    description:
      'Studio review of the 160ml Yixing Zhuni Shui Ping clay teapot, testing water-level balance, multi-hole clay filtration, and high-heat oolong dynamics.',
    brand: 'Yixing Zisha Artisan',
  },
  'zero-japan-universal-artisan-teapot': {
    title: 'Zero Japan Universal Teapot Review | TeapotsCool',
    description:
      'Hands-on lab review of the Zero Japan Universal 450ml stoneware teapot, testing drip-free spout geometry, clip-on stainless lid, and ceramic heat balance.',
    brand: 'Zero Japan',
  },
  'forlife-stump-extra-fine-infuser-teapot': {
    title: 'FORLIFE Stump Teapot (18oz) Review | TeapotsCool',
    description:
      'Lab review of the FORLIFE Stump 18oz (530ml) ceramic teapot, testing its 0.3-mm stainless steel infuser, hinged flip lid, and drip-free spout cutoff.',
    brand: 'FORLIFE',
  },
};

const seoMeta = TEAPOT_SEO_META[slug];
const seoTitle = seoMeta?.title ?? `${name} Review | TeapotsCool`;
const seoDescription = seoMeta?.description ?? description;
const seoBrand = seoMeta?.brand ?? name.split(' ')[0];
const market = getTeapotMarketData(slug);

const productReviewSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: seoDescription,
  image: [imageUrl],
  brand: {
    '@type': 'Brand',
    name: seoBrand,
  },
  category: style,
  material,
  url: pageUrl,
  ...(market
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: market.buyerRating,
          reviewCount: market.buyerReviewCount,
          bestRating: 5,
          worstRating: 1,
        },
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'USD',
          lowPrice: market.lowPrice,
          highPrice: market.highPrice,
          offerCount: market.offerCount,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Material', value: material },
    { '@type': 'PropertyValue', name: 'Capacity', value: capacityLabel },
    { '@type': 'PropertyValue', name: 'Pour Precision Score', value: `${pourLabel}/10` },
    { '@type': 'PropertyValue', name: 'Heat Retention Score', value: `${heatLabel}/10` },
    { '@type': 'PropertyValue', name: 'Infuser Style', value: infuserType },
    { '@type': 'PropertyValue', name: 'Stovetop Safe', value: stovetopSafe },
  ],
  review: {
    '@type': 'Review',
    name: `${name} — Studio Pour & Thermal Review`,
    author: {
      '@type': 'Person',
      name: EDITORIAL_AUTHOR.name,
      url: EDITORIAL_AUTHOR.url,
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: combinedRating,
      bestRating: 10,
      worstRating: 1,
    },
    reviewBody: verdict,
    positiveNotes: {
      '@type': 'ItemList',
      itemListElement: pros.map((pro, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: pro,
      })),
    },
    negativeNotes: {
      '@type': 'ItemList',
      itemListElement: cons.map((con, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: con,
      })),
    },
  },
};

const breadcrumbSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Curated Gallery', item: `${SITE_URL}/gallery/` },
    { '@type': 'ListItem', position: 3, name, item: pageUrl },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalPath={pagePath}
  ogImage={image}
  schemas={[productReviewSchema, breadcrumbSchema]}
>
  <article class="editorial-container py-8 sm:py-10 space-y-10">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-xs font-mono text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Home
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/gallery/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Curated Gallery
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-charcoal font-medium">{name}</li>
      </ol>
    </nav>

    <DisclosureBanner />

    <!-- Showcase Split Hero -->
    <section aria-labelledby="teapot-title" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      <div class="lg:col-span-6 flex flex-col justify-between gap-4">
        <div class="border border-border-subtle rounded-md overflow-hidden bg-stone">
          <img
            src={image}
            alt={imageAlt}
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
            class="w-full aspect-[4/3] object-cover"
          />
        </div>

        <div class="border border-border-subtle bg-stone/45 rounded-md p-4 space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border-subtle pb-2">
            <span class="eyebrow">Studio Benchmark Summary</span>
            <span class="font-mono text-xs font-semibold text-matcha tabular-nums">
              Overall Score: {combinedRating}/10
            </span>
          </div>
          <p class="text-xs sm:text-sm text-charcoal leading-relaxed">{verdict}</p>
        </div>
      </div>

      <div class="lg:col-span-6 space-y-6">
        <div class="space-y-2.5">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-semibold bg-matcha text-rice">
              {badge}
            </span>
            <span class="font-mono text-xs font-semibold text-charcoal border border-border-strong bg-stone/60 px-2.5 py-1 rounded-full tabular-nums">
              {market ? `${market.priceRange} (${priceTier})` : `Tier: ${priceTier}`}
            </span>
            {market && (
              <span class="font-mono text-xs font-semibold text-terracotta-text border border-border-subtle px-2.5 py-1 rounded-full tabular-nums">
                ★ {market.buyerRating}/5 ({market.buyerReviewCount.toLocaleString('en-US')}+ reviews)
              </span>
            )}
            <span class="font-mono text-xs text-muted uppercase tracking-wider">
              {style}
            </span>
          </div>

          <h1 id="teapot-title" class="font-serif font-semibold text-charcoal">
            {name}
          </h1>
          <p class="text-lg text-muted leading-relaxed">{subtitle}</p>
        </div>

        <p class="text-sm text-charcoal bg-stone/70 border-l-4 border-l-matcha px-4 py-3 rounded-r">
          <strong class="font-semibold">Best For:</strong> {bestFor}
        </p>

        <!-- Pour & Heat Benchmarks -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 py-4 border-y border-border-subtle">
          <div>
            <div class="flex items-center justify-between text-xs font-mono mb-1.5">
              <span class="text-muted uppercase tracking-wider">Pour Precision</span>
              <span class="font-semibold text-charcoal tabular-nums">{pourLabel}/10</span>
            </div>
            <div class="score-bar" style={`--score: ${clampedPour}`} aria-hidden="true" />
          </div>
          <div>
            <div class="flex items-center justify-between text-xs font-mono mb-1.5">
              <span class="text-muted uppercase tracking-wider">Heat Retention</span>
              <span class="font-semibold text-charcoal tabular-nums">{heatLabel}/10</span>
            </div>
            <div
              class="score-bar"
              style={`--score: ${clampedHeat}; --score-color: var(--accent-terracotta-text);`}
              aria-hidden="true"
            />
          </div>
        </div>

        <!-- Spec Sheet (<dl> Ledger) -->
        <dl class="divide-y divide-border-subtle border-y border-border-subtle text-sm">
          <div class="py-2.5 flex items-baseline justify-between gap-4">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Material</dt>
            <dd class="font-medium text-charcoal text-right">{material}</dd>
          </div>
          <div class="py-2.5 flex items-baseline justify-between gap-4">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Capacity</dt>
            <dd class="font-medium text-charcoal text-right">
              {capacityLabel} <span class="text-xs text-muted">({capacityTier})</span>
            </dd>
          </div>
          <div class="py-2.5 flex items-baseline justify-between gap-4">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Infuser Style</dt>
            <dd class="font-medium text-charcoal text-right">{infuserType}</dd>
          </div>
          <div class="py-2.5 flex items-baseline justify-between gap-4">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Stovetop Safe</dt>
            <dd class="font-medium text-charcoal text-right">{stovetopSafe}</dd>
          </div>
          {market && (
            <>
              <div class="py-2.5 flex items-baseline justify-between gap-4">
                <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">
                  Typical Retail Price
                </dt>
                <dd class="font-mono font-semibold text-charcoal text-right tabular-nums">
                  {market.priceRange}
                </dd>
              </div>
              <div class="py-2.5 flex items-baseline justify-between gap-4">
                <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">
                  Where Sold
                </dt>
                <dd class="font-medium text-charcoal text-right">{market.whereToBuy}</dd>
              </div>
            </>
          )}
        </dl>

        <!-- Studio CTAs -->
        <div class="pt-2 space-y-2.5">
          <div class="flex flex-wrap items-center gap-3">
            <a href="/tools/tea-steeping-timer/" class="btn-matcha">
              Launch Interactive Steep Timer &rarr;
            </a>
            <a href={clusterHubHref} class="btn-hairline">
              Explore {clusterMeta.shortTitle} Hub &rarr;
            </a>
          </div>
          <p class="text-xs text-muted">
            Bench-verified for spout cut-off precision and 30-minute thermal stability.
          </p>
        </div>
      </div>
    </section>

    <!-- Pros, Cons & Clara Vance Studio Verdict -->
    <section
      aria-labelledby="verdict-heading"
      class="border-y-2 border-t-charcoal border-b-border-strong bg-stone/45 py-7 px-6 sm:px-8 space-y-6"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2 pb-4 border-b border-border-subtle">
        <div>
          <p class="eyebrow">Studio Evaluation</p>
          <h2 id="verdict-heading" class="font-serif text-2xl font-semibold text-charcoal mt-1">
            Clara Vance’s Pour &amp; Craft Verdict
          </h2>
        </div>
        <span class="font-mono text-sm font-semibold text-matcha tabular-nums">
          Overall Studio Score: {combinedRating}/10
        </span>
      </div>

      <p class="text-base text-charcoal leading-relaxed max-w-none">{verdict}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-0 md:divide-x md:divide-border-subtle pt-5 border-t border-border-subtle">
        <div class="md:pr-8">
          <h3 class="font-mono text-xs uppercase tracking-wider font-semibold text-matcha mb-3">
            Why It Stands Out
          </h3>
          <ul class="space-y-2 text-sm text-charcoal">
            {pros.map((pro) => (
              <li class="flex items-start gap-2.5">
                <span class="font-mono font-bold text-matcha shrink-0" aria-hidden="true">+</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="md:pl-8">
          <h3 class="font-mono text-xs uppercase tracking-wider font-semibold text-terracotta-text mb-3">
            Things to Consider
          </h3>
          <ul class="space-y-2 text-sm text-muted">
            {cons.map((con) => (
              <li class="flex items-start gap-2.5">
                <span class="font-mono font-bold text-terracotta-text shrink-0" aria-hidden="true">–</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Verified Online Buyer Ratings & Multi-Store Consensus -->
    {market && (
      <section
        aria-labelledby="buyer-reviews-heading"
        class="border border-border-subtle bg-rice rounded-md p-6 sm:p-8 space-y-5"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-3 pb-4 border-b border-border-subtle">
          <div>
            <p class="eyebrow">Public Marketplace Sentiment · Real Owner Feedback</p>
            <h2 id="buyer-reviews-heading" class="font-serif text-2xl font-semibold text-charcoal mt-1">
              What Verified Online Buyers Say
            </h2>
          </div>
          <div class="text-right">
            <span class="font-serif text-2xl font-semibold text-terracotta-text tabular-nums">
              ★ {market.buyerRating}/5
            </span>
            <p class="font-mono text-[11px] text-muted tabular-nums">
              Across ~{market.buyerReviewCount.toLocaleString('en-US')}+ store &amp; specialty reviews
            </p>
          </div>
        </div>

        <p class="text-base text-charcoal leading-relaxed max-w-none">
          {market.buyerConsensus}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-3 border-t border-border-subtle text-sm">
          <div class="p-4 rounded bg-stone/45 space-y-1">
            <p class="font-mono text-[10px] uppercase tracking-wider text-matcha font-semibold">
              Typical Price &amp; Sellers
            </p>
            <p class="font-mono text-sm font-semibold text-charcoal tabular-nums">
              {market.priceRange}
            </p>
            <p class="text-xs text-muted">{market.whereToBuy}</p>
          </div>
          <div class="p-4 rounded bg-stone/45 space-y-1">
            <p class="font-mono text-[10px] uppercase tracking-wider text-matcha font-semibold">
              Most Praised by Owners
            </p>
            <p class="text-xs text-charcoal leading-relaxed">{market.buyerPraise}</p>
          </div>
          <div class="p-4 rounded bg-stone/45 space-y-1">
            <p class="font-mono text-[10px] uppercase tracking-wider text-terracotta-text font-semibold">
              Common Buyer Caveat
            </p>
            <p class="text-xs text-muted leading-relaxed">{market.buyerCaveat}</p>
          </div>
        </div>
      </section>
    )}

    <!-- Editorial MDX Review Body -->
    <section aria-label="Detailed teapot review" class="pt-2">
      <div class="prose prose-tea max-w-none lg:columns-2 lg:gap-12 [&_h2]:break-after-avoid [&_h2:first-of-type]:mt-0 [&_p]:break-inside-avoid-column">
        <slot />
      </div>
    </section>

    <!-- Featured In Our Lab Guides & Benchmarks (Bidirectional PageRank Graph) -->
    {featuredInGuides.length > 0 && (
      <section aria-labelledby="featured-guides-heading" class="pt-10 border-t border-border-subtle space-y-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">
              Lab Citations &middot; {featuredInGuides.length}{' '}
              {featuredInGuides.length === 1 ? 'Guide' : 'Guides'}
            </p>
            <h2 id="featured-guides-heading" class="font-serif text-2xl sm:text-3xl font-semibold text-charcoal mt-1">
              Featured In Our Lab Guides &amp; Benchmarks
            </h2>
          </div>
          <a
            href="/guides/"
            class="inline-flex items-center min-h-[44px] text-sm font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
          >
            Browse all lab guides &rarr;
          </a>
        </div>

        <div
          class:list={[
            'grid grid-cols-1 gap-6',
            featuredInGuides.length === 1
              ? 'md:grid-cols-1'
              : featuredInGuides.length === 2 || featuredInGuides.length === 4
                ? 'md:grid-cols-2'
                : 'md:grid-cols-2 lg:grid-cols-3',
          ]}
        >
          {featuredInGuides.map((guide) => {
            const guideClusterMeta = getClusterMeta(guide.data.cluster);
            const citedEntry = guide.data.affiliateProducts?.find((p) => p.teapotSlug === slug);
            return (
              <article class="border border-border-subtle border-l-4 border-l-matcha bg-rice rounded-md overflow-hidden flex flex-col">
                <a href={getGuideUrl(guide)} class="block border-b border-border-subtle">
                  <img
                    src={guide.data.featuredImage}
                    alt={guide.data.featuredImageAlt}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    class="w-full aspect-[16/9] object-cover"
                  />
                </a>
                <div class="p-5 flex-1 flex flex-col justify-between gap-3">
                  <div class="space-y-2">
                    <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
                      <span class="uppercase tracking-wider text-terracotta-text font-semibold">
                        {guideClusterMeta.shortTitle}
                      </span>
                      <span class="text-muted tabular-nums">
                        {estimateReadingTime(guide.body, guide.data.readingTime)}
                      </span>
                    </div>
                    {citedEntry?.badge && (
                      <p class="font-mono text-[11px] font-semibold text-matcha">
                        Bench Role: {citedEntry.badge}
                      </p>
                    )}
                    <h3 class="font-serif text-lg font-semibold text-charcoal leading-snug">
                      <a href={getGuideUrl(guide)} class="hover:text-matcha">
                        {guide.data.title}
                      </a>
                    </h3>
                    <p class="text-sm text-muted line-clamp-2">{guide.data.description}</p>
                  </div>
                  <a
                    href={getGuideUrl(guide)}
                    class="inline-flex items-center min-h-[44px] text-sm font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
                  >
                    Read {guide.data.isPillar ? 'Pillar Guide' : guideClusterMeta.shortTitle} benchmark &rarr;
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- Remaining Related Guides from Cluster (excluding featuredInGuides to avoid duplicates) -->
    {relatedGuides.length > 0 && (
      <section aria-labelledby="teapot-guides-heading" class="pt-10 border-t border-border-subtle space-y-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">{clusterMeta.accentLabel}</p>
            <h2 id="teapot-guides-heading" class="font-serif text-2xl sm:text-3xl font-semibold text-charcoal mt-1">
              {featuredInGuides.length > 0
                ? `More ${clusterMeta.shortTitle} Guides`
                : 'Care & Brewing Guides for This Vessel'}
            </h2>
          </div>
          <a
            href={clusterHubHref}
            class="inline-flex items-center min-h-[44px] text-sm font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
          >
            Explore {clusterMeta.shortTitle} &rarr;
          </a>
        </div>

        <div
          class:list={[
            'grid grid-cols-1 gap-6',
            relatedGuides.length === 1
              ? 'md:grid-cols-1'
              : relatedGuides.length === 2
                ? 'md:grid-cols-2'
                : 'md:grid-cols-3',
          ]}
        >
          {relatedGuides.map((guide) => {
            const guideClusterMeta = getClusterMeta(guide.data.cluster);
            return (
              <article class="border border-border-subtle bg-rice rounded-md overflow-hidden flex flex-col">
                <a href={getGuideUrl(guide)} class="block border-b border-border-subtle">
                  <img
                    src={guide.data.featuredImage}
                    alt={guide.data.featuredImageAlt}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    class="w-full aspect-[16/9] object-cover"
                  />
                </a>
                <div class="p-5 flex-1 flex flex-col justify-between gap-3">
                  <div class="space-y-1.5">
                    <p class="font-mono text-[11px] uppercase tracking-wider text-terracotta-text font-semibold">
                      {guide.data.isPillar ? 'Pillar Guide' : guideClusterMeta.shortTitle} ·{' '}
                      {estimateReadingTime(guide.body, guide.data.readingTime)}
                    </p>
                    <h3 class="font-serif text-lg font-semibold text-charcoal leading-snug">
                      <a href={getGuideUrl(guide)} class="hover:text-matcha">
                        {guide.data.title}
                      </a>
                    </h3>
                    <p class="text-sm text-muted line-clamp-2">{guide.data.description}</p>
                  </div>
                  <a
                    href={getGuideUrl(guide)}
                    class="inline-flex items-center min-h-[44px] text-sm font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
                  >
                    Read {guideClusterMeta.shortTitle} guide &rarr;
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
