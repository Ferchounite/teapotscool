---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DisclosureBanner from '../components/DisclosureBanner.astro';
import AffiliateProductCard from '../components/AffiliateProductCard.astro';
import TableOfContents, { type TocHeading } from '../components/TableOfContents.astro';
import ClusterNav from '../components/ClusterNav.astro';
import BrewingTimerWidget from '../components/BrewingTimerWidget.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import {
  SITE_URL,
  EDITORIAL_AUTHOR,
  getClusterMeta,
  getClusterHubHref,
  getGuideLeafSlug,
  getTeapotLeafSlug,
  getGuideUrl,
  estimateReadingTime,
  formatIsoDate,
} from '../lib/clusterUi';

export interface Props {
  entry: CollectionEntry<'guides'>;
  headings: TocHeading[];
}

const { entry, headings } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  cluster,
  featuredImage,
  featuredImageAlt,
  isPillar,
  author,
  readingTime,
  affiliateProducts: rawAffiliateProducts,
  faqs,
} = entry.data;

const allTeapots = await getCollection('teapots');
const teapotsBySlug = new Map(allTeapots.map((t) => [getTeapotLeafSlug(t), t.data]));
const affiliateProducts = (rawAffiliateProducts ?? []).map((product) => {
  const canonical = product.teapotSlug ? teapotsBySlug.get(product.teapotSlug) : undefined;
  if (!canonical) return product;
  return {
    ...product,
    material: canonical.material,
    capacity: canonical.capacityLabel,
    pourScore: canonical.pourScore,
    heatScore: canonical.heatScore,
    priceTier: canonical.priceTier,
  };
});

const clusterMeta = getClusterMeta(cluster);
const clusterHubHref = getClusterHubHref(cluster);
const leafSlug = getGuideLeafSlug(entry);
const guidePath = getGuideUrl(entry);
const guideUrl = new URL(guidePath, SITE_URL).toString();
const imageUrl = featuredImage.startsWith('http')
  ? featuredImage
  : new URL(featuredImage, SITE_URL).toString();
const calculatedReadingTime = estimateReadingTime(entry.body, readingTime);
const wordCount = entry.body ? entry.body.trim().split(/\s+/).filter(Boolean).length : 0;

const GUIDE_SEO_META: Record<string, { title: string; description?: string }> = {
  'coolest-unique-teapots': {
    title: '25 Coolest Unique Teapots That Pour Well | TeapotsCool',
  },
  'best-glass-flowering-teapots': {
    title: 'Best Glass & Flowering Teapots (Tested) | TeapotsCool',
    description:
      'Hands-on test of the best borosilicate glass and flowering teapots—comparing stovetop safety, blooming dome height, and drip-free spout precision.',
  },
  'japanese-kyusu-teapots-guide': {
    title: 'Authentic Japanese Kyusu Teapot Guide | TeapotsCool',
    description:
      'Master authentic Japanese kyusu teapots: yokode side-handle ergonomics, Tokoname clay mineral physics, and sasame ceramic mesh vs. steel strainers.',
  },
  'best-cast-iron-tetsubin-teapots': {
    title: 'Best Cast Iron Teapots (Tetsubin) Guide | TeapotsCool',
    description:
      'Hands-on comparison of enamel-lined cast iron teapots vs. raw Japanese Nanbu Tekki tetsubin, tested for heat retention, pour balance, and rust care.',
  },
  'quirky-novelty-teapots-gifts': {
    title: '15 Quirky & Whimsical Novelty Teapots | TeapotsCool',
    description:
      'Discover 15 quirky and whimsical novelty teapots—from magnetic Gongfu brewers to sculptural ceramic pots—bench-tested so they pour cleanly without drips.',
  },
  'complete-teapot-care-guide': {
    title: 'How to Clean & Descale Any Teapot | TeapotsCool',
    description:
      'A material-by-material protocol to clean, descale, and preserve glass, porcelain, raw Zisha clay, Tokoname stoneware, and cast iron teapots safely.',
  },
  'how-to-season-cast-iron-teapot': {
    title: 'How to Season a Cast Iron Teapot Safely | TeapotsCool',
  },
  'remove-tea-stains-glass-ceramic': {
    title: 'How to Remove Tea Stains From Teapots | TeapotsCool',
    description:
      'Dissolve polymerized tea tannins from glass and ceramic teapots in 15 minutes using sodium percarbonate, baking soda, or citric acid—with zero bleach.',
  },
  'can-you-put-glass-teapot-on-stove': {
    title: 'Can You Put a Glass Teapot on the Stove? | TeapotsCool',
  },
  'why-does-my-teapot-drip': {
    title: 'Why Does My Teapot Drip? Physics & Fixes | TeapotsCool',
    description:
      'Understand the Coandă effect, spout lip radius, lid-vent airlock, and surface tension behind teapot dribbling—plus four practical fixes that work fast.',
  },
  'teapot-materials-comparison': {
    title: 'Cast Iron vs Glass vs Clay vs Ceramic | TeapotsCool',
    description:
      'Compare thermal conductivity, heat retention, mineral porosity, and tea pairing across cast iron, borosilicate glass, Zisha clay, and glazed porcelain.',
  },
  'yixing-clay-vs-porcelain': {
    title: 'Yixing Zisha Clay vs. Porcelain Teapots | TeapotsCool',
    description:
      'Discover the mineral physics of porous Yixing Zisha clay versus vitrified porcelain—and why one smooths tannins while the other sharpens high aroma.',
  },
  'enamel-lined-vs-unlined-cast-iron': {
    title: 'Enamel Cast Iron vs. Raw Tetsubin Guide | TeapotsCool',
    description:
      'Learn the critical differences in lining chemistry, stovetop safety, iron mineral release, and rust care between enamel cast iron pots and raw tetsubin.',
  },
  'kyusu-vs-gaiwan': {
    title: 'Kyusu vs. Gaiwan: Which Vessel Is Best? | TeapotsCool',
    description:
      'Side-handle Japanese kyusu vs. lidded Chinese porcelain gaiwan: compare extraction speed, leaf geometry, thermal grip, and ideal loose-leaf tea pairings.',
  },
  'best-teapot-for-each-tea-type': {
    title: 'Best Teapot for Every Tea Type (Chart) | TeapotsCool',
    description:
      'Match green sencha, rolled oolong, black tea, pu-erh, and herbal infusions to the ideal teapot material—comparing clay, glass, porcelain, and cast iron.',
  },
  'teapot-size-chart-guide': {
    title: 'Teapot Size & Capacity Chart (ml to oz) | TeapotsCool',
    description:
      'Convert teapot milliliters to ounces and cups (150ml to 1200ml) and find the exact vessel size for solo Gongfu brewing, couples, or 4-person tea service.',
  },
  'do-teapots-contain-lead-glaze-safety': {
    title: 'Do Teapots Contain Lead? Glaze Safety | TeapotsCool',
    description:
      'Learn how to check ceramic, porcelain, cast iron, and vintage teapots for lead or cadmium glazes—plus why borosilicate glass and Tokoname clay are inert.',
  },
  'why-green-tea-tastes-bitter-teapot-temp': {
    title: 'Why Green Tea Tastes Bitter (Thermal Fix) | TeapotsCool',
    description:
      'Discover why high water temperature and thick heat-retaining teapots make green tea bitter—and how kyusu clay or glass vessels unlock sweet umami.',
  },
  'how-to-tell-real-vs-fake-yixing-teapot': {
    title: 'Real vs. Fake Yixing Teapot: 5 Lab Tests | TeapotsCool',
    description:
      'Spot chemical mud and slip-cast fake Yixing teapots using 5 non-destructive checks: mica mineral flecks, water film absorption, acoustic pitch, and weight.',
  },
  'japanese-kyusu-vs-cast-iron-tetsubin': {
    title: 'Japanese Kyusu vs. Cast Iron Tetsubin | TeapotsCool',
    description:
      'Tokoname clay side-handle kyusu vs. enameled cast iron tetsubin: compare thermal decay, pour precision, green vs. black tea pairing, and daily maintenance.',
  },
};

const seoTitle = GUIDE_SEO_META[leafSlug]?.title ?? `${title} | TeapotsCool`;
const seoDescription = GUIDE_SEO_META[leafSlug]?.description ?? description;

// 1. Article JSON-LD
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: seoDescription,
  image: [imageUrl],
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  wordCount,
  articleSection: clusterMeta.title,
  inLanguage: 'en-US',
  keywords: entry.data.primaryKeyword ?? clusterMeta.dataForSeoTopKeywords.slice(0, 5).join(', '),
  author: {
    '@type': 'Person',
    name: author || EDITORIAL_AUTHOR.name,
    url: EDITORIAL_AUTHOR.url,
    jobTitle: 'Tea Vessel Researcher & Ceramicist',
    knowsAbout: [
      'Teapots',
      'Japanese Kyusu',
      'Cast Iron Tetsubin',
      'Borosilicate Glass Teaware',
      'Gongfu Tea Brewing',
    ],
  },
  publisher: {
    '@type': 'Organization',
    name: 'TeapotsCool',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/brand/logo-mark.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': guideUrl,
  },
};

// 2. BreadcrumbList JSON-LD
const breadcrumbSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE_URL}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guides',
      item: `${SITE_URL}/guides/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: clusterMeta.shortTitle,
      item: new URL(clusterHubHref, SITE_URL).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: title,
      item: guideUrl,
    },
  ],
};

const schemas: Record<string, unknown>[] = [articleSchema, breadcrumbSchema];

// 3. FAQPage JSON-LD (if faqs populated)
if (faqs && faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

// 4. ItemList of Product / Review JSON-LD (if affiliateProducts populated, zero static dollar prices)
if (affiliateProducts && affiliateProducts.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${title} — Tested Teapots`,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: affiliateProducts.length,
    itemListElement: affiliateProducts.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Product',
        name: product.name,
        material: product.material,
        url: product.teapotSlug
          ? `${SITE_URL}/gallery/${product.teapotSlug}/`
          : guideUrl,
        review: {
          '@type': 'Review',
          author: {
            '@type': 'Person',
            name: author || EDITORIAL_AUTHOR.name,
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: Number(((product.pourScore + (product.heatScore ?? 8)) / 2).toFixed(1)),
            bestRating: 10,
            worstRating: 1,
          },
          reviewBody:
            product.bestFor ??
            `${product.badge} teapot evaluated for pour precision (${product.pourScore}/10) and heat retention.`,
        },
      },
    })),
  });
}

const topPick = affiliateProducts?.[0];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalPath={guidePath}
  ogImage={featuredImage}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate.toISOString()}
  schemas={schemas}
>
  <div class="reading-progress" style="--scroll-progress: 0%;" aria-hidden="true" data-reading-progress />

  <article class="editorial-container py-8 sm:py-10 space-y-8" data-article-root>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-xs font-mono text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Home
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/guides/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Guides
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a
            href={clusterHubHref}
            class="hover:text-matcha underline underline-offset-4 py-1 inline-block"
          >
            {clusterMeta.shortTitle}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-charcoal font-medium truncate max-w-[30ch] sm:max-w-none">
          {title}
        </li>
      </ol>
    </nav>

    <!-- Editorial Masthead Header -->
    <header class="space-y-5 max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={clusterHubHref}
          class="inline-flex items-center min-h-[36px] px-3 py-1 rounded-full border border-border-strong bg-stone/70 text-xs font-mono font-semibold uppercase tracking-wider text-charcoal hover:border-matcha hover:text-matcha transition-colors"
        >
          {clusterMeta.shortTitle}
        </a>
        {isPillar && (
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-matcha-soft text-matcha text-xs font-mono font-semibold uppercase tracking-wider">
            Pillar Reference Guide
          </span>
        )}
        <span class="font-mono text-[11px] uppercase tracking-[0.09em] text-muted">
          Studio Dispatch · EN-US
        </span>
      </div>

      <h1 class="font-serif font-semibold text-charcoal">{title}</h1>

      <p class="text-lg sm:text-xl text-muted leading-relaxed max-w-[64ch]">{description}</p>

      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 pt-3 border-t border-border-subtle text-xs font-mono text-muted">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <span class="inline-flex items-center gap-2">
            <img
              src="/images/brand/logo-mark.svg"
              alt=""
              width="20"
              height="20"
              class="w-5 h-5 bg-transparent"
            />
            By{' '}
            <a href="/about/" class="font-semibold text-charcoal underline underline-offset-4 hover:text-matcha">
              {author || EDITORIAL_AUTHOR.name}
            </a>
          </span>
          <span>
            Updated <time datetime={updatedDate.toISOString()}>{formatIsoDate(updatedDate)}</time>
          </span>
          <span class="tabular-nums">{calculatedReadingTime}</span>
        </div>
      </div>

      <DisclosureBanner compact={true} />
    </header>

    <!-- Two-Column Asymmetric Editorial Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_316px] xl:grid-cols-[minmax(0,1fr)_336px] gap-10 xl:gap-14 pt-2">
      <div class="min-w-0 space-y-10">
        <!-- Featured LCP Image inside editorial column -->
        <figure class="space-y-2.5">
          <div class="border border-border-subtle rounded-md overflow-hidden bg-stone">
            <img
              src={featuredImage}
              alt={featuredImageAlt}
              width="1200"
              height="675"
              fetchpriority="high"
              decoding="async"
              class="w-full aspect-[16/9] object-cover"
            />
          </div>
          <figcaption class="font-mono text-[11px] text-muted flex flex-wrap items-center justify-between gap-2 border-b border-border-subtle pb-2">
            <span>Fig. 01 — {featuredImageAlt}</span>
            <span class="uppercase tracking-wider">TeapotsCool Studio Archive</span>
          </figcaption>
        </figure>

        <!-- Above-the-Fold Quick Verdict / Top Pick -->
        {topPick && (
          <AffiliateProductCard
            name={topPick.name}
            badge={topPick.badge}
            material={topPick.material}
            capacity={topPick.capacity}
            pourScore={topPick.pourScore}
            heatScore={topPick.heatScore}
            priceTier={topPick.priceTier}
            bestFor={topPick.bestFor}
            pros={topPick.pros}
            cons={topPick.cons}
            teapotSlug={topPick.teapotSlug}
            variant="quick-verdict"
          />
        )}

        <div class="prose prose-tea max-w-[68ch]">
          <slot />
        </div>

        <!-- Full Tested Picks Section -->
        {affiliateProducts && affiliateProducts.length > 0 && (
          <section aria-labelledby="tested-picks-heading" class="pt-10 border-t border-border-strong space-y-6">
            <div>
              <p class="eyebrow">Hands-On Benchmarks</p>
              <h2 id="tested-picks-heading" class="font-serif text-2xl sm:text-3xl font-semibold text-charcoal mt-1">
                Tested Picks &amp; Recommendations
              </h2>
            </div>
            <div class="space-y-6">
              {affiliateProducts.map((product) => (
                <AffiliateProductCard
                  name={product.name}
                  badge={product.badge}
                  material={product.material}
                  capacity={product.capacity}
                  pourScore={product.pourScore}
                  heatScore={product.heatScore}
                  priceTier={product.priceTier}
                  bestFor={product.bestFor}
                  pros={product.pros}
                  cons={product.cons}
                  teapotSlug={product.teapotSlug}
                  variant="full"
                />
              ))}
            </div>
          </section>
        )}

        <!-- Native Accessible FAQ Accordion (schema already emitted in head) -->
        <FaqAccordion faqs={faqs} emitSchema={false} />
      </div>

      <!-- Unified Sticky Architectural Rail (zero stacked boxes) -->
      <aside
        aria-label="Guide tools and navigation"
        class="space-y-8 lg:border-l lg:border-border-subtle lg:pl-8 xl:pl-10 lg:sticky lg:top-24 lg:self-start"
      >
        <TableOfContents headings={headings} />
        <ClusterNav
          cluster={cluster}
          currentSlug={leafSlug}
          isPillar={isPillar}
          mode="sidebar-callout"
        />
        <div class="border-t border-border-subtle pt-6">
          <BrewingTimerWidget compact={true} />
        </div>
      </aside>
    </div>

    <ClusterNav
      cluster={cluster}
      currentSlug={leafSlug}
      isPillar={isPillar}
      mode="bottom-related"
    />
  </article>
</BaseLayout>

<script>
  function initReadingProgress() {
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const article = document.querySelector<HTMLElement>('[data-article-root]');
    if (!bar || !article || bar.dataset.bound === 'true') return;
    bar.dataset.bound = 'true';

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = article.getBoundingClientRect();
      const totalScrollable = Math.max(1, article.offsetHeight - window.innerHeight * 0.65);
      const scrolled = Math.max(0, -rect.top);
      const pct = Math.min(100, Math.max(0, (scrolled / totalScrollable) * 100));
      bar.style.setProperty('--scroll-progress', `${pct.toFixed(1)}%`);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }

  initReadingProgress();
  document.addEventListener('astro:page-load', initReadingProgress);
</script>
