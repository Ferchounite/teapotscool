---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL, AMAZON_TAG } from '../lib/clusterUi';

const pagePath = '/affiliate-disclosure/';
const pageUrl = new URL(pagePath, SITE_URL).toString();

const webPageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Affiliate Disclosure — FTC & Amazon Associates | TeapotsCool',
  url: pageUrl,
  description:
    'Full FTC 16 CFR Part 255 and Amazon Associates affiliate disclosure for TeapotsCool.com.',
};
---

<BaseLayout
  title="Affiliate Disclosure (FTC & Amazon Associates) | TeapotsCool"
  description="Read how TeapotsCool funds independent teapot testing through Amazon Associates and specialty affiliate partnerships at zero extra cost to readers."
  canonicalPath={pagePath}
  schemas={[webPageSchema]}
>
  <article class="editorial-container py-8 sm:py-12 space-y-8">
    <nav aria-label="Breadcrumb" class="text-xs font-mono text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Home
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-charcoal font-medium">Affiliate Disclosure</li>
      </ol>
    </nav>

    <header class="space-y-3 max-w-3xl pb-6 border-b border-border-subtle">
      <p class="eyebrow">Legal &amp; Reader Transparency</p>
      <h1 class="font-serif font-semibold text-charcoal">
        Affiliate &amp; Editorial Disclosure
      </h1>
      <p class="font-mono text-xs text-muted">
        Effective Date: November 17, 2026 · Compliance: FTC 16 CFR Part 255 &amp; Amazon Associates Operating Agreement
      </p>
    </header>

    <div class="prose prose-tea max-w-[68ch]">
      <h2>Amazon Associates Program Notice</h2>
      <p>
        <strong>TeapotsCool.com</strong> is a participant in the Amazon Services LLC Associates
        Program (tracking identifier <code>{AMAZON_TAG}</code>), an affiliate advertising program
        designed to provide a means for sites to earn advertising fees by advertising and linking
        to Amazon.com and affiliated regional storefronts.
      </p>
      <p>
        In plain English: when you click a product recommendation link marked with{' '}
        <code>rel="nofollow sponsored noopener"</code>—such as our{' '}
        <em>Check Current Price on Amazon</em> buttons—and complete a qualifying purchase,
        TeapotsCool may receive a modest referral commission.{' '}
        <strong>This never increases the price you pay.</strong>
      </p>

      <h2>Specialty Tea &amp; Artisan Ceramic Retailers</h2>
      <p>
        In addition to Amazon, select showcase pages in our{' '}
        <a href="/gallery/">Curated Teapot Gallery</a> may link to specialty ceramic shops or
        independent tea ware retailers (for example, Etsy studios or regional Japanese kilns).
        Where affiliate tracking is active on those outbound links, it is disclosed clearly above
        the recommendation block.
      </p>

      <h2>Dynamic Pricing &amp; Availability Disclaimer</h2>
      <p>
        Product prices and availability on Amazon and third-party storefronts fluctuate frequently.
        Accordingly, TeapotsCool intentionally displays qualitative price tiers (<code>$</code>,{' '}
        <code>$$</code>, <code>$$$</code>) rather than static dollar figures. Any price or stock
        status displayed on the retailer’s site at the moment of purchase applies to your order.
      </p>

      <h2>Editorial Independence Guarantee</h2>
      <p>
        Affiliate eligibility never dictates which vessels earn top Pour Precision or Heat
        Retention scores. We regularly highlight flaws, awkward handles, or narrow infuser cages on
        products that qualify for referral fees, and we never accept payment in exchange for
        favorable reviews or guaranteed gallery placement. Learn more on our{' '}
        <a href="/about/">About &amp; Testing Methodology</a> page.
      </p>

      <h2>Display Advertising Disclosure</h2>
      <p>
        TeapotsCool reserves non-intrusive display ad slots (such as our sticky sidebar placeholder)
        for vetted programmatic partners including Google AdSense or Journey by Mediavine. Display
        advertisements are clearly separated from editorial product recommendations.
      </p>
    </div>
  </article>
</BaseLayout>
