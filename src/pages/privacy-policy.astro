---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../lib/clusterUi';

const pagePath = '/privacy-policy/';
const pageUrl = new URL(pagePath, SITE_URL).toString();

const webPageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy — GDPR & CCPA | TeapotsCool',
  url: pageUrl,
  description:
    'Privacy Policy for TeapotsCool.com covering edge logs, privacy-preserving analytics, local browser state, and GDPR/CCPA user rights.',
};
---

<BaseLayout
  title="Privacy Policy (GDPR & CCPA) | TeapotsCool"
  description="Learn how TeapotsCool.com handles minimal browser data, anonymized Google Analytics telemetry, local steep-timer state, and your GDPR/CCPA privacy rights."
  canonicalPath={pagePath}
  schemas={[webPageSchema]}
>
  <article class="editorial-container py-8 sm:py-12 space-y-8">
    <nav aria-label="Breadcrumb" class="text-xs font-mono text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Home
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-charcoal font-medium">Privacy Policy</li>
      </ol>
    </nav>

    <header class="space-y-3 max-w-3xl pb-6 border-b border-border-subtle">
      <p class="eyebrow">Data Protection &amp; Cookies</p>
      <h1 class="font-serif font-semibold text-charcoal">Privacy Policy</h1>
      <p class="font-mono text-xs text-muted">
        Effective Date: November 17, 2026 · Domain: teapotscool.com
      </p>
    </header>

    <div class="prose prose-tea max-w-[68ch]">
      <h2>1. Overview &amp; Minimal Data Footprint</h2>
      <p>
        <strong>TeapotsCool.com</strong> is a non-commercial, static editorial publication. We do not
        require user accounts, logins, or newsletter sign-ups to browse our teapot gallery, read our
        guides, or use our <a href="/tools/tea-steeping-timer/">Interactive Tea Steeping Timer</a>{' '}
        (which runs entirely inside your browser without transmitting timer state to any server).
      </p>

      <h2>2. Server Logs &amp; Edge Hosting</h2>
      <p>
        TeapotsCool is served over Cloudflare Pages global edge infrastructure. Standard network
        logs may temporarily process anonymized IP addresses, user-agent strings, and requested
        paths strictly for DDoS mitigation, security diagnostics, and reliable page delivery.
      </p>

      <h2>3. Privacy-Preserving Analytics</h2>
      <p>
        We use Google Analytics 4 with IP anonymization enabled solely to measure aggregate organic
        readership and understand which teapot care, materials, and brewing guides help visitors
        most. TeapotsCool currently runs without display advertising networks or affiliate tracking
        scripts. You can opt out of analytics at any time using your browser privacy controls or the
        official Google Analytics Opt-out Browser Add-on.
      </p>

      <h2>4. Your Rights Under GDPR (EEA/UK) &amp; CCPA/CPRA (California)</h2>
      <p>
        If you reside in the European Economic Area, the United Kingdom, or California, you have
        the right to request access to personal data (if any is held), request deletion or
        correction, opt out of analytics telemetry, and manage cookie preferences via your browser
        settings. TeapotsCool does not sell personal information for monetary consideration.
      </p>

      <h2>5. Editorial Independence &amp; Policy Updates</h2>
      <p>
        We may update this Privacy Policy periodically as site tools evolve. Any revisions take
        effect upon publication on this page with an updated effective date. Read more about our
        independent bench testing standards on the <a href="/about/">About &amp; Testing Lab</a>{' '}
        page.
      </p>
    </div>
  </article>
</BaseLayout>
