---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | TeapotsCool"
  description="This teapot or tea guide could not be found in the TeapotsCool studio archive."
  canonicalPath="/404/"
  noindex={true}
>
  <section
    aria-labelledby="not-found-heading"
    class="editorial-container py-16 sm:py-24 flex flex-col items-center text-center space-y-6"
  >
    <img
      src="/images/brand/mascot-koko-curating.png"
      alt="Koko the Kyusu tea pet searching for a missing teapot with a magnifying glass"
      width="240"
      height="180"
      class="w-60 aspect-[4/3] rounded-md border border-border-subtle object-cover bg-stone"
    />

    <div class="space-y-3 max-w-xl">
      <p class="eyebrow">404 · Vessel Missing From Shelf</p>
      <h1 id="not-found-heading" class="font-serif font-semibold text-charcoal">
        This Vessel Has Left the Kiln
      </h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed">
        Koko checked every bench in our studio, but the page you requested does not exist or has
        moved to a permanent archive route.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a href="/" class="btn-matcha">Return Home</a>
      <a href="/gallery/" class="btn-hairline">Explore Curated Gallery</a>
      <a href="/guides/" class="btn-hairline">Browse Tea Guides</a>
      <a href="/tools/tea-steeping-timer/" class="btn-hairline">Tea Steeping Timer</a>
    </div>
  </section>
</BaseLayout>
