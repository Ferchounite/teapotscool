---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrewingTimerWidget from '../components/BrewingTimerWidget.astro';
import {
  SITE_URL,
  CLUSTER_LIST,
  getClusterHubHref,
  getGuideUrl,
  getTeapotUrl,
  formatScore,
} from '../lib/clusterUi';

const allTeapots = await getCollection('teapots');
const featuredTeapots = allTeapots
  .filter((t) => t.data.featured)
  .sort((a, b) => b.data.pourScore - a.data.pourScore);
const showcaseTeapots =
  featuredTeapots.length >= 7 ? featuredTeapots.slice(0, 7) : allTeapots.slice(0, 7);
const spotlightTeapot = showcaseTeapots[0];
const matrixTeapots = showcaseTeapots.slice(1, 7);

const allGuides = await getCollection('guides');

const webSiteSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TeapotsCool',
  url: `${SITE_URL}/`,
  description:
    'Independent editorial directory of sculptural, Japanese kyusu, cast iron tetsubin, and borosilicate glass teapots tested for clean laminar pour physics and thermal craft.',
};

const featuredItemListSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Featured Curated Teapots',
  numberOfItems: showcaseTeapots.length,
  itemListElement: showcaseTeapots.map((teapot, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: new URL(getTeapotUrl(teapot), SITE_URL).toString(),
    name: teapot.data.name,
  })),
};
---

<BaseLayout
  title="Unique Teapots & Pour Physics Lab | TeapotsCool"
  description="Discover borosilicate glass, Japanese kyusu, and cast iron teapots tested hands-on for clean non-drip pouring, heat retention, and daily tea craft."
  canonicalPath="/"
  schemas={[webSiteSchema, featuredItemListSchema]}
  showTopDisclosure={true}
>
  <!-- Editorial Hero -->
  <section aria-labelledby="hero-heading" class="border-b border-border-subtle bg-rice">
    <div class="editorial-container py-10 sm:py-14 lg:py-16 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <p class="eyebrow">Issue 01 · Independent Teaware Archive</p>
        <h1 id="hero-heading" class="font-serif font-semibold text-charcoal">
          Cool &amp; Unique Teapots That Actually Pour Well
        </h1>
        <p class="text-base sm:text-lg text-muted leading-relaxed max-w-[58ch]">
          Four out of five sculptural teapots drip, glug, or starve leaves in cramped baskets. We
          test every vessel for laminar spout cut-off, thermal endurance, and enduring tactile craft.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="/gallery/" class="btn-matcha">
            Explore Curated Gallery
          </a>
          <a href="/guides/buying-guides/coolest-unique-teapots/" class="btn-hairline">
            Read the 25 Picks Pillar Guide
          </a>
        </div>

        <dl class="grid grid-cols-3 gap-4 pt-6 border-t border-border-subtle text-sm">
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Curated Vessels</dt>
            <dd class="font-serif text-2xl sm:text-3xl font-semibold text-charcoal tabular-nums mt-0.5">
              {allTeapots.length}
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Deep Guides</dt>
            <dd class="font-serif text-2xl sm:text-3xl font-semibold text-charcoal tabular-nums mt-0.5">
              {allGuides.length}
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Lab Metrics</dt>
            <dd class="font-serif text-xl sm:text-2xl font-semibold text-charcoal mt-0.5">Pour &amp; Heat</dd>
          </div>
        </dl>
      </div>

      <figure class="lg:col-span-6 space-y-2">
        <div class="border border-border-subtle rounded-md overflow-hidden bg-stone">
          <img
            src="/images/hero-teapot-japandi.png"
            alt="Artisan Japanese clay kyusu pouring steaming emerald sencha tea into a stoneware cup in soft morning light"
            width="1200"
            height="800"
            fetchpriority="high"
            decoding="async"
            class="w-full aspect-[3/2] object-cover"
          />
        </div>
        <figcaption class="font-mono text-[11px] text-muted flex flex-wrap items-center justify-between gap-2">
          <span>Fig. 01 — Tokoname Yokode Kyusu laminar pour evaluation · 80°C Sencha</span>
          <span class="uppercase tracking-wider">Clara Vance Lab</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Asymmetric Featured Curated Teapots -->
  <section aria-labelledby="featured-teapots-heading" class="editorial-container py-12 sm:py-16 space-y-8">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border-strong pb-5">
      <div class="space-y-1.5">
        <p class="eyebrow">Studio Benchmark Showcase</p>
        <h2 id="featured-teapots-heading" class="font-serif font-semibold text-charcoal">
          Featured Curated Teapots
        </h2>
        <p class="text-sm sm:text-base text-muted max-w-[60ch]">
          Every vessel is graded 1–10 on laminar spout precision and 30-minute thermal stability.
        </p>
      </div>
      <a
        href="/gallery/"
        class="inline-flex items-center min-h-[44px] text-sm font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
      >
        Browse full {allTeapots.length}-vessel directory &rarr;
      </a>
    </div>

    {spotlightTeapot && (
      <article class="border border-border-strong bg-stone/40 rounded-md overflow-hidden grid grid-cols-1 lg:grid-cols-12">
        <a
          href={getTeapotUrl(spotlightTeapot)}
          class="lg:col-span-7 block border-b lg:border-b-0 lg:border-r border-border-subtle overflow-hidden"
        >
          <img
            src={spotlightTeapot.data.image}
            alt={spotlightTeapot.data.imageAlt}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="w-full h-full aspect-[4/3] object-cover transition-transform duration-300 hover:scale-[1.02]"
          />
        </a>

        <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between gap-6">
          <div class="space-y-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="eyebrow">Flagship Pour Benchmark</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-matcha text-rice">
                {spotlightTeapot.data.badge}
              </span>
            </div>

            <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-charcoal leading-tight">
              <a href={getTeapotUrl(spotlightTeapot)} class="hover:text-matcha transition-colors">
                {spotlightTeapot.data.name}
              </a>
            </h3>

            <p class="font-mono text-xs text-muted">
              {spotlightTeapot.data.material} · {spotlightTeapot.data.capacityLabel} · Tier{' '}
              {spotlightTeapot.data.priceTier}
            </p>

            <p class="text-sm sm:text-base text-muted leading-relaxed">
              {spotlightTeapot.data.verdict}
            </p>
          </div>

          <div class="space-y-5 pt-4 border-t border-border-subtle">
            <div class="grid grid-cols-2 gap-6">
              <div>
                <div class="flex items-baseline justify-between gap-2 mb-1.5">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-muted">Pour</span>
                  <span class="font-serif text-xl font-semibold text-charcoal tabular-nums">
                    {formatScore(spotlightTeapot.data.pourScore)}<span class="font-mono text-xs text-muted">/10</span>
                  </span>
                </div>
                <div class="score-bar" style={`--score: ${spotlightTeapot.data.pourScore}`} aria-hidden="true" />
              </div>
              <div>
                <div class="flex items-baseline justify-between gap-2 mb-1.5">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-muted">Heat</span>
                  <span class="font-serif text-xl font-semibold text-charcoal tabular-nums">
                    {formatScore(spotlightTeapot.data.heatScore)}<span class="font-mono text-xs text-muted">/10</span>
                  </span>
                </div>
                <div
                  class="score-bar"
                  style={`--score: ${spotlightTeapot.data.heatScore}; --score-color: var(--accent-terracotta-text);`}
                  aria-hidden="true"
                />
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <a href={getTeapotUrl(spotlightTeapot)} class="btn-matcha w-full text-sm">
                Read Full Studio Review &rarr;
              </a>
            </div>
          </div>
        </div>
      </article>
    )}

    {matrixTeapots.length > 0 && (
      <div class="hairline-grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 rounded-md overflow-hidden">
        {matrixTeapots.map((teapot) => {
          const href = getTeapotUrl(teapot);
          const pourStr = formatScore(teapot.data.pourScore);
          const heatStr = formatScore(teapot.data.heatScore);
          return (
            <article class="flex flex-col hover:bg-stone/35 transition-colors">
              <a href={href} class="block border-b border-border-subtle overflow-hidden">
                <img
                  src={teapot.data.image}
                  alt={teapot.data.imageAlt}
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-[4/3] object-cover transition-transform duration-300 hover:scale-[1.02]"
                />
              </a>

              <div class="p-6 flex-1 flex flex-col justify-between gap-5">
                <div class="space-y-2.5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-matcha-soft text-matcha">
                      {teapot.data.badge}
                    </span>
                    <span class="font-mono text-xs text-muted">{teapot.data.priceTier}</span>
                  </div>

                  <h3 class="font-serif text-xl font-semibold text-charcoal leading-snug">
                    <a href={href} class="hover:text-matcha transition-colors">
                      {teapot.data.name}
                    </a>
                  </h3>

                  <p class="font-mono text-xs text-muted">
                    {teapot.data.material} · {teapot.data.capacityLabel}
                  </p>

                  <p class="text-sm text-muted leading-relaxed line-clamp-2">
                    {teapot.data.subtitle}
                  </p>
                </div>

                <div class="space-y-4">
                  <div class="grid grid-cols-2 gap-4 pt-3 border-t border-border-subtle">
                    <div>
                      <div class="flex items-center justify-between text-[11px] font-mono mb-1">
                        <span class="text-muted">Pour</span>
                        <span class="font-semibold text-charcoal tabular-nums">{pourStr}/10</span>
                      </div>
                      <div class="score-bar" style={`--score: ${teapot.data.pourScore}`} aria-hidden="true" />
                    </div>
                    <div>
                      <div class="flex items-center justify-between text-[11px] font-mono mb-1">
                        <span class="text-muted">Heat</span>
                        <span class="font-semibold text-charcoal tabular-nums">{heatStr}/10</span>
                      </div>
                      <div
                        class="score-bar"
                        style={`--score: ${teapot.data.heatScore}; --score-color: var(--accent-terracotta-text);`}
                        aria-hidden="true"
                      />
                    </div>
                  </div>

                  <div class="flex flex-wrap items-center gap-2.5">
                    <a href={href} class="btn-matcha w-full text-sm">
                      Read Studio Review &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- 3 SEO Topic Cluster Silos (Architectural 3-Column Index) -->
  <section aria-labelledby="clusters-heading" class="border-y border-border-strong bg-stone/45 py-12 sm:py-16">
    <div class="editorial-container space-y-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="space-y-1.5">
          <p class="eyebrow">Editorial Library · 3 Topic Clusters</p>
          <h2 id="clusters-heading" class="font-serif font-semibold text-charcoal">
            Buying, Care &amp; Materials Knowledge Base
          </h2>
        </div>
        <a
          href="/guides/"
          class="inline-flex items-center min-h-[44px] text-sm font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
        >
          View all {allGuides.length} guides &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 border-y border-border-strong bg-rice divide-y lg:divide-y-0 lg:divide-x divide-border-subtle">
        {CLUSTER_LIST.map((cluster, idx) => {
          const clusterGuides = allGuides.filter((g) => g.data.cluster === cluster.slug);
          const pillar = clusterGuides.find((g) => g.data.isPillar);
          const spokes = clusterGuides.filter((g) => !g.data.isPillar);
          const hubHref = getClusterHubHref(cluster.slug);
          return (
            <section class="p-6 sm:p-7 flex flex-col justify-between gap-6">
              <div class="space-y-4">
                <div class="flex items-baseline justify-between gap-3">
                  <span class="font-serif italic text-3xl text-terracotta-text font-medium tabular-nums">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <span class="eyebrow">{cluster.accentLabel}</span>
                </div>

                <h3 class="font-serif text-2xl font-semibold text-charcoal leading-snug">
                  <a href={hubHref} class="hover:text-matcha transition-colors">
                    {cluster.title}
                  </a>
                </h3>
                <p class="text-sm text-muted leading-relaxed">{cluster.description}</p>

                {pillar && (
                  <div class="pt-4 border-t border-border-subtle space-y-1">
                    <span class="font-mono text-[11px] uppercase tracking-wider font-semibold text-matcha">
                      Pillar Reference
                    </span>
                    <a
                      href={getGuideUrl(pillar)}
                      class="block py-1 font-serif text-base font-semibold text-charcoal hover:text-matcha underline underline-offset-4"
                    >
                      {pillar.data.title}
                    </a>
                  </div>
                )}

                {spokes.length > 0 && (
                  <ul class="pt-3 border-t border-border-subtle divide-y divide-border-subtle/70">
                    {spokes.map((spoke) => (
                      <li>
                        <a
                          href={getGuideUrl(spoke)}
                          class="flex items-center min-h-[44px] py-1.5 text-sm text-charcoal hover:text-matcha hover:underline underline-offset-4 leading-snug"
                        >
                          {spoke.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <a
                href={hubHref}
                class="btn-hairline w-full justify-between"
              >
                <span>Explore {cluster.shortTitle}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </section>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Interactive Brewing Timer + Meet Koko Companion -->
  <section aria-labelledby="timer-section-heading" class="editorial-container py-12 sm:py-16 space-y-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-5 space-y-6">
        <p class="eyebrow">Precision Steep Utility</p>
        <h2 id="timer-section-heading" class="font-serif font-semibold text-charcoal">
          Steep Every Leaf at Its Sweet Spot
        </h2>
        <p class="text-base text-muted leading-relaxed">
          Even the sharpest Tokoname kyusu cannot save green tea scorched in boiling water. Match
          your leaf cultivar and teapot material below for vessel-aware timing and a soft audio
          chime.
        </p>

        <!-- Koko Welcome Callout -->
        <div class="border-y border-border-subtle py-5 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <img
            src="/images/brand/teapotscool-logo-mascot.png"
            alt="Koko — TeapotsCool's smiling terracotta Kyusu tea pet mascot with a matcha sprout"
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
            class="w-28 h-28 sm:w-32 sm:h-32 rounded-full border border-border-subtle object-cover bg-rice shrink-0"
          />
          <div class="space-y-2">
            <p class="eyebrow">Meet Koko</p>
            <h3 class="font-serif text-lg font-semibold text-charcoal leading-snug">
              Your Steep &amp; Pour Companion
            </h3>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">
              Inspired by traditional ceramic tea pets and Japanese side-handle kyusu, Koko watches
              over every studio pour test.
            </p>
            <div class="flex flex-wrap gap-3 pt-1">
              <a
                href="/tools/tea-steeping-timer/"
                class="inline-flex items-center min-h-[44px] text-xs font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
              >
                Full-screen Tea Timer &rarr;
              </a>
              <a
                href="/about/"
                class="inline-flex items-center min-h-[44px] text-xs font-semibold text-charcoal underline underline-offset-4 hover:text-matcha"
              >
                Meet Koko &amp; Clara &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <BrewingTimerWidget compact={false} />
      </div>
    </div>

    <!-- Clara Vance Editorial Manifesto Callout -->
    <aside
      aria-label="Editorial manifesto"
      class="border-y border-border-strong border-l-4 border-l-terracotta bg-stone/45 py-7 px-6 sm:px-8 flex flex-col md:flex-row md:items-center justify-between gap-6"
    >
      <div class="space-y-2 max-w-2xl">
        <p class="eyebrow">Editorial Standards · Clara Vance</p>
        <h2 class="font-serif text-2xl font-semibold text-charcoal">
          No Paid Placements. Only Vessels That Earn Shelf Space.
        </h2>
        <p class="text-sm sm:text-base text-muted leading-relaxed">
          Every teapot in our gallery is evaluated on spout shear physics, strainer clearance, and
          30-minute thermal loss—published 100% independently with zero sponsored placements.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a href="/about/" class="btn-matcha">Our Testing Methodology</a>
        <a href="/gallery/" class="btn-hairline">Browse Curated Archive</a>
      </div>
    </aside>
  </section>
</BaseLayout>
