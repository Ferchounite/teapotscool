---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DisclosureBanner from '../../../components/DisclosureBanner.astro';
import {
  SITE_URL,
  CLUSTER_LIST,
  getClusterMeta,
  getClusterHubHref,
  getGuideUrl,
  estimateReadingTime,
  formatIsoDate,
  type ClusterSlug,
} from '../../../lib/clusterUi';

export function getStaticPaths() {
  return CLUSTER_LIST.map((cluster) => ({
    params: { cluster: cluster.slug },
    props: { clusterSlug: cluster.slug },
  }));
}

interface Props {
  clusterSlug: ClusterSlug;
}

const { clusterSlug } = Astro.props;
const clusterMeta = getClusterMeta(clusterSlug);
const hubPath = getClusterHubHref(clusterSlug);
const hubUrl = new URL(hubPath, SITE_URL).toString();

const allGuides = await getCollection('guides');
const clusterGuides = allGuides
  .filter((g) => g.data.cluster === clusterSlug)
  .sort((a, b) => {
    if (a.data.isPillar !== b.data.isPillar) return a.data.isPillar ? -1 : 1;
    return b.data.updatedDate.getTime() - a.data.updatedDate.getTime();
  });

const pillar = clusterGuides.find((g) => g.data.isPillar);
const spokes = clusterGuides.filter((g) => !g.data.isPillar);

const collectionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: clusterMeta.title,
  description: clusterMeta.description,
  url: hubUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: clusterGuides.length,
    itemListElement: clusterGuides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(getGuideUrl(guide), SITE_URL).toString(),
      name: guide.data.title,
    })),
  },
};

const breadcrumbSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/guides/` },
    { '@type': 'ListItem', position: 3, name: clusterMeta.shortTitle, item: hubUrl },
  ],
};
---

<BaseLayout
  title={`${clusterMeta.title} | TeapotsCool`}
  description={clusterMeta.description}
  canonicalPath={hubPath}
  schemas={[collectionSchema, breadcrumbSchema]}
>
  <div class="editorial-container py-8 sm:py-12 space-y-10">
    <nav aria-label="Breadcrumb" class="text-xs font-mono text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Home
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/guides/" class="hover:text-matcha underline underline-offset-4 py-1 inline-block">
            Guides
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-charcoal font-medium">{clusterMeta.shortTitle}</li>
      </ol>
    </nav>

    <header class="space-y-4 max-w-3xl pb-6 border-b border-border-subtle">
      <p class="eyebrow">{clusterMeta.accentLabel}</p>
      <h1 class="font-serif font-semibold text-charcoal">{clusterMeta.title}</h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed">{clusterMeta.description}</p>
      <p class="text-xs font-mono text-muted">
        Target Reader: <span class="text-charcoal">{clusterMeta.targetAudience}</span>
      </p>
    </header>

    <DisclosureBanner />

    {pillar && (
      <section aria-labelledby="pillar-spotlight-heading" class="space-y-4">
        <h2 id="pillar-spotlight-heading" class="eyebrow">Featured Pillar Guide</h2>
        <article class="border border-border-subtle border-l-4 border-l-matcha bg-stone/60 rounded-md overflow-hidden grid grid-cols-1 lg:grid-cols-12">
          <a href={getGuideUrl(pillar)} class="lg:col-span-5 block border-b lg:border-b-0 lg:border-r border-border-subtle">
            <img
              src={pillar.data.featuredImage}
              alt={pillar.data.featuredImageAlt}
              width="800"
              height="450"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full aspect-[16/9] object-cover"
            />
          </a>
          <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between gap-5">
            <div class="space-y-3">
              <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono">
                <span class="px-2.5 py-0.5 rounded-full bg-matcha text-rice font-semibold uppercase tracking-wider">
                  Flagship Pillar
                </span>
                <span class="text-muted">
                  Updated {formatIsoDate(pillar.data.updatedDate)} ·{' '}
                  {estimateReadingTime(pillar.body, pillar.data.readingTime)}
                </span>
              </div>
              <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-charcoal leading-snug">
                <a href={getGuideUrl(pillar)} class="hover:text-matcha transition-colors">
                  {pillar.data.title}
                </a>
              </h3>
              <p class="text-sm sm:text-base text-muted leading-relaxed">
                {pillar.data.description}
              </p>
            </div>
            <div>
              <a href={getGuideUrl(pillar)} class="btn-matcha">
                Read Complete Pillar Guide
              </a>
            </div>
          </div>
        </article>
      </section>
    )}

    {spokes.length > 0 ? (
      <section aria-labelledby="spokes-heading" class="space-y-6">
        <h2 id="spokes-heading" class="font-serif text-2xl font-semibold text-charcoal">
          Deep-Dive Articles in {clusterMeta.shortTitle}
        </h2>
        <div class:list={[
          'hairline-grid rounded-md overflow-hidden',
          spokes.length === 2 || spokes.length === 4 ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
        ]}>
          {spokes.map((spoke) => (
            <article class="flex flex-col hover:bg-stone/35 transition-colors">
              <a href={getGuideUrl(spoke)} class="block border-b border-border-subtle">
                <img
                  src={spoke.data.featuredImage}
                  alt={spoke.data.featuredImageAlt}
                  width="640"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-[16/9] object-cover"
                />
              </a>
              <div class="p-5 flex-1 flex flex-col justify-between gap-4">
                <div class="space-y-2">
                  <p class="font-mono text-xs text-muted">
                    Updated {formatIsoDate(spoke.data.updatedDate)} ·{' '}
                    {estimateReadingTime(spoke.body, spoke.data.readingTime)}
                  </p>
                  <h3 class="font-serif text-lg sm:text-xl font-semibold text-charcoal leading-snug">
                    <a href={getGuideUrl(spoke)} class="hover:text-matcha transition-colors">
                      {spoke.data.title}
                    </a>
                  </h3>
                  <p class="text-sm text-muted line-clamp-3">{spoke.data.description}</p>
                </div>
                <a
                  href={getGuideUrl(spoke)}
                  class="inline-flex items-center min-h-[44px] text-sm font-semibold text-matcha underline underline-offset-4 hover:text-terracotta-text"
                >
                  Read article &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : (
      !pillar && (
        <div class="border border-border-subtle bg-stone/50 rounded-md p-8 text-center space-y-3">
          <p class="eyebrow">Coming Soon</p>
          <p class="text-base text-muted">New articles for this topic cluster are currently being tested in our studio.</p>
          <a href="/guides/" class="btn-hairline">Browse all guides</a>
        </div>
      )
    )}

    <!-- Cross-Cluster Quick Links -->
    <nav aria-label="Other topic clusters" class="pt-8 border-t border-border-subtle flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-xs uppercase tracking-wider text-muted font-semibold">
        Explore Other Clusters
      </p>
      <div class="flex flex-wrap gap-2.5">
        {CLUSTER_LIST.filter((c) => c.slug !== clusterSlug).map((other) => (
          <a href={getClusterHubHref(other.slug)} class="btn-hairline text-sm">
            {other.shortTitle} &rarr;
          </a>
        ))}
      </div>
    </nav>
  </div>
</BaseLayout>
