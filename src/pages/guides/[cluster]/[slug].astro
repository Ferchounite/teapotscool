---
import { getCollection, type CollectionEntry } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import AffiliateProductCard from '../../../components/AffiliateProductCard.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';
import BrewingTimerWidget from '../../../components/BrewingTimerWidget.astro';
import TeaTimer from '../../../components/TeaTimer.astro';
import DisclosureBanner from '../../../components/DisclosureBanner.astro';
import { getGuideLeafSlug } from '../../../lib/clusterUi';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: {
      cluster: entry.data.cluster,
      slug: getGuideLeafSlug(entry),
    },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
---

<GuideLayout entry={entry} headings={headings}>
  <Content
    components={{
      AffiliateProductCard,
      AffiliateCard,
      BrewingTimerWidget,
      TeaTimer,
      DisclosureBanner,
    }}
  />
</GuideLayout>
